+// Runtime switch for the H8-MR opacity-absorbed moment-space geometry adjoint.
+// Default OFF; read on every launch so one binary serves both arms and a single
+// process can toggle arms between passes.
+inline bool h8_mr_enabled()
+{
+    const char *v = std::getenv("GSPLAT_H8_MR");
+    return v != nullptr && v[0] == '1' && v[1] == '\0';
