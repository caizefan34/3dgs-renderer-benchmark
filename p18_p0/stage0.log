[2/6] Forward Raster Inner Loop Audit
--------------------------------------
[KERNEL] macro_tile_rasterize_kernel<16> @ MacroTileRasterize.cu:192
[CONFIG] TILE_SIZE=16, GAUSS_PER_WARP=1, N_PAIRS=4, CTA=320, 10 warps/CTA

[GAUSS_EVAL] rasterizeGaussian lambda @ lines 287-330
  sigma = hfma2(u1,u1, hfma2(u0,u0, neg_log_opac))   // fp16 FMA
  u0 = l00*dx + l10*dy
  u1 = l11*dy
  dx = __hsub2(__low2half2(xy_mt_j), offset_x)       // half2, 2px
  dy = __hsub2(mean_y, offset_y[pp])                 // half2, 2px
  EXP: __h2exp2_approx(__hneg2(sigma))               // half2 MUFU.EX2 (NOT expf/__expf/PTX)
  CONIC: smem_conic_raw[idx] = {l00,l10,l11,-log2(opac)} * CHOL_SCALE(=13.589)
  FUSION: alpha = exp2(-sigma) = opac * exp2(-(u0^2+u1^2))  // opac folded in

[ALPHA]
  threshold: sigma < log2(255)=7.9943534  (ALPHA_THRESHOLD=1/255)
  reject:    ok_mask → alpha=0 if sub-threshold
  clamp:     NONE in forward (MAX_ALPHA=0.99 only in backward)
  T_update:  acc[pp][3] = __hsub2_sat(acc[pp][3], alpha*T)
  terminate: MIN_TRANSPARENCY=1e-4, warp ballot on tile_done==DONE_MASK

[THREAD_MAP] lane l → (x=l&15, y=l>>4)
  lane 0-15  → y=0, x=0..15
  lane 16-31 → y=1, x=0..15
  N_PAIRS=4: pair pp → rows (thread_y+2pp, thread_y+2pp+1)
  Total: 32 lanes × 8 px = 256 = 16×16 ✓

[RASTER_LOOP]
  fill:  per mini-batch (32 gauss), per-lane popc → warp_queue (contiguous list)
  drain: uint4 LDS → 8× rasterizeGaussian (UNROLL=8), tail for <8
  exit:  tile_done==DONE_MASK for ALL lanes → ballot==~0u → break

