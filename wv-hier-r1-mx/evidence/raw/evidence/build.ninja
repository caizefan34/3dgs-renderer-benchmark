ninja_required_version = 1.3
cxx = c++
nvcc = /home/liaoyuanjun/miniforge3/envs/anysplat/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=gsplat_cuda -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -I/home/liaoyuanjun/.local/lib/python3.10/site-packages/gsplat/cuda/include -I/home/liaoyuanjun/.local/lib/python3.10/site-packages/gsplat/cuda/csrc/third_party/glm -isystem /home/liaoyuanjun/miniforge3/envs/anysplat/lib/python3.10/site-packages/torch/include -isystem /home/liaoyuanjun/miniforge3/envs/anysplat/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /home/liaoyuanjun/miniforge3/envs/anysplat/lib/python3.10/site-packages/torch/include/TH -isystem /home/liaoyuanjun/miniforge3/envs/anysplat/lib/python3.10/site-packages/torch/include/THC -isystem /home/liaoyuanjun/miniforge3/envs/anysplat/include -isystem /home/liaoyuanjun/miniforge3/envs/anysplat/include/python3.10 -D_GLIBCXX_USE_CXX11_ABI=0 -fPIC -std=c++17 -O3 -Wno-attributes
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=gsplat_cuda -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -I/home/liaoyuanjun/.local/lib/python3.10/site-packages/gsplat/cuda/include -I/home/liaoyuanjun/.local/lib/python3.10/site-packages/gsplat/cuda/csrc/third_party/glm -isystem /home/liaoyuanjun/miniforge3/envs/anysplat/lib/python3.10/site-packages/torch/include -isystem /home/liaoyuanjun/miniforge3/envs/anysplat/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /home/liaoyuanjun/miniforge3/envs/anysplat/lib/python3.10/site-packages/torch/include/TH -isystem /home/liaoyuanjun/miniforge3/envs/anysplat/lib/python3.10/site-packages/torch/include/THC -isystem /home/liaoyuanjun/miniforge3/envs/anysplat/include -isystem /home/liaoyuanjun/miniforge3/envs/anysplat/include/python3.10 -D_GLIBCXX_USE_CXX11_ABI=0 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_80,code=compute_80 -gencode=arch=compute_80,code=sm_80 --compiler-options '-fPIC' -O3 -use_fast_math -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
ldflags = -shared -L/home/liaoyuanjun/miniforge3/envs/anysplat/lib/python3.10/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/home/liaoyuanjun/miniforge3/envs/anysplat/lib -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags



rule link
  command = $cxx $in $ldflags -o $out

build RasterizeToPixelsFromWorld3DGSFwd.cuda.o: cuda_compile /home/liaoyuanjun/.local/lib/python3.10/site-packages/gsplat/cuda/csrc/RasterizeToPixelsFromWorld3DGSFwd.cu
