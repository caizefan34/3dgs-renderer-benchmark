    "P1_MAIN": {
      "type": "30K",
      "required": true,
      "description": "13 scenes x B1A/C0 x seed42 = 26 runs; cross-system reproduction."
    },
    "P2_ABLATION": {
      "type": "30K",
      "required": true,
      "description": "13 scenes x A0/A1/A2 = 39 new runs; C0 reused from P1; reproduce ladder on SXM4."
    },
    "P3_EPS2D": {
      "type": "30K",
      "required": true,
      "description": "room/bicycle/garden missing corners only = 6 new runs; base corners reused from P1."
    },
    "P4_MULTISEED": {
      "type": "30K",
      "required": true,
      "description": "4 scenes x B1A/C0 x seeds43/44 = 16 new runs; seed42 reused from P1."
    },
    "P5_H8_MECHANISM": {
      "type": "microbench",
      "required": true,
      "description": "room/bicycle/garden direct backward H8 off/on; correctness + timing; no new production branch."
    },
    "P6_H8_GENERALITY": {
      "type": "microbench",
      "required": true,
      "description": "Port the same sufficient-statistic adjoint to a pristine gsplat backward or isolated drop-in validation path; correctness + 3-scene microbench only. This is validation of generality, not a C0 code change."
    }
  },
