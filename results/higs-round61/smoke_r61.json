{
  "device": "NVIDIA A100-SXM4-80GB",
  "torch": "2.7.0+cu128",
  "config": {
    "base_dir": "/root/epic05-data/processed",
    "scene": [
      "mipnerf360/garden"
    ],
    "backends": [
      "higs_dynamic_ts"
    ],
    "n_train": 4,
    "n_eval": 3,
    "steps": 120,
    "width": 1280,
    "height": 720,
    "seed": 0,
    "densify_every": 5,
    "densify_threshold": 0.005,
    "prune_threshold": 0.01,
    "out": "/tmp/qsR61smoke/smoke_r61.json",
    "radius_clip": 0.0,
    "anchor_densify": true,
    "anchor_densify_every": 2,
    "densify_grad_accum": false,
    "res_schedule": null,
    "res_schedule_full_signal": false,
    "res_schedule_full_lpips": false,
    "tile_sampling_ratio": 0.35,
    "sampling_mode": "error_guided",
    "pixel_raster_ratio": 0.35,
    "pixel_sampling_ratio": 1.0,
    "error_alpha": 1.0,
    "error_refresh_every": 25,
    "error_lambda": 0.7,
    "eval_every": 60,
    "lr_decay": 0.1,
    "densify_window": 1500,
    "lpips_loss_weight": 0.1,
    "lpips_loss_every": 25,
    "lpips_full_res": true,
    "cull_interval": 1,
    "cull_interval_schedule": null,
    "masked_adam": true,
    "mask_prune": true,
    "fused_adam": true
  },
  "scenes": {
    "mipnerf360/garden": [
      {
        "backend": "higs_dynamic_ts",
        "error": "m/v/g must have N rows"
      }
    ]
  }
}