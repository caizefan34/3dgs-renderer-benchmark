+                    const vec3 conic = conic_batch[t]; const vec3 xy_opac = xy_opacity_batch[t];
+                    const vec2 delta = {xy_opac.x - px[q], xy_opac.y - py[q]};
+                    const HigsCfWeight gw = higs_cf_weight<SIGMA_GATE, UV_REUSE>(conic, delta.x, delta.y, xy_opac.z);
+#ifdef HIGS_BWD_CF_INSTRUMENT
+                    if constexpr(SIGMA_GATE)
+                    {
+                        atomicAdd((unsigned long long *)&sigma_stats[0], 1ULL);
+                        if(gw.pre_drop) atomicAdd((unsigned long long *)&sigma_stats[1], 1ULL);
+                        else if(gw.pre_clamp) atomicAdd((unsigned long long *)&sigma_stats[2], 1ULL);
+                        else atomicAdd((unsigned long long *)&sigma_stats[3], 1ULL);
+                    }
+#endif
+                    if(!gw.valid) valid[q] = false;
+                    else
+                    {
+                        any_valid = true;
+                        float v_rgb_q[CDIM] = {0.f}; vec3 v_conic_q = {0.f, 0.f, 0.f};
+                        vec2 v_xy_q = {0.f, 0.f}; float v_opacity_q = 0.f;
+                        higs_cf_blend_bwd_step<CDIM, SCALAR_ADJOINT, UV_REUSE>(
+                            conic, delta, xy_opac.z, gw, rgbs_batch + t * CDIM, v_render_c[q],
+                            v_render_a[q], T_final[q], backgrounds, T[q], buffer[q], buffer_dot[q],
+                            tail_const[q], v_rgb_q, v_conic_q, v_xy_q, v_opacity_q);
+#pragma unroll
+                        for(uint32_t k = 0; k < CDIM; ++k) v_rgb_local[k] += v_rgb_q[k];
+                        v_conic_local.x += v_conic_q.x; v_conic_local.y += v_conic_q.y; v_conic_local.z += v_conic_q.z;
+                        v_xy_local.x += v_xy_q.x; v_xy_local.y += v_xy_q.y; v_opacity_local += v_opacity_q;
+                    }
+                }
+            }
+            if(!warp.any(any_valid)) continue;
+            warpSum<CDIM>(v_rgb_local, warp); warpSum(v_conic_local, warp);
+            warpSum(v_xy_local, warp); warpSum(v_opacity_local, warp);
+            if(warp.thread_rank() == 0)
