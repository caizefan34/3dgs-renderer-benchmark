+// ============================================================================
+// H2-BWD-CF: isolated compute-factored PX backward variants.
+//
+// The baseline higs_blend_bwd_px_kernel above is intentionally left untouched.
+// This companion kernel is selected only by HIGS_BWD_CF_VARIANT.  Its template
+// flags keep each experimental variant independently compilable and make the
+// combined variant exactly the requested composition of the three factors.
+// ============================================================================
+enum HigsBwdCfVariant : int
+{
+    HIGS_BWD_CF_BASELINE = 0,
+    HIGS_BWD_CF_SIGMA_GATE = 1,
+    HIGS_BWD_CF_SCALAR_ADJOINT = 2,
+    HIGS_BWD_CF_UV_REUSE = 4,
+    HIGS_BWD_CF_COMBINED = 7,
+};
+
+struct HigsCfWeight
+{
+    float vis;
+    float alpha;
+    float ux;
+    float uy;
+    bool valid;
+    bool pre_drop;
+    bool pre_clamp;
+};
+
+template<bool SIGMA_GATE, bool UV_REUSE>
+__device__ __forceinline__ HigsCfWeight higs_cf_weight(
+    const vec3 &conic, const float dx, const float dy, const float opac)
+{
+    HigsCfWeight out;
+    if constexpr(UV_REUSE)
+    {
+        out.ux = conic.x * dx + conic.y * dy;
+        out.uy = conic.y * dx + conic.z * dy;
+    }
+    else
+    {
+        out.ux = 0.f;
+        out.uy = 0.f;
+    }
+    const float sigma = UV_REUSE
+        ? 0.5f * (dx * out.ux + dy * out.uy)
+        : 0.5f * (conic.x * dx * dx + conic.z * dy * dy) + conic.y * dx * dy;
+    out.pre_drop = false;
+    out.pre_clamp = false;
+    if constexpr(SIGMA_GATE)
+    {
+        // Retain the legacy predicate boundaries: sigma < 0 and alpha <
+        // ALPHA_THRESHOLD are invalid; equality is contributing.  No exp is
+        // evaluated in the mathematically excluded or strictly clamped region.
+        if(sigma < 0.f || opac < ALPHA_THRESHOLD)
+        {
+            out.vis = 0.f;
+            out.alpha = 0.f;
+            out.valid = false;
+            out.pre_drop = true;
+            return out;
+        }
+        const float sigma_drop = logf(opac / ALPHA_THRESHOLD);
+        if(sigma > sigma_drop)
+        {
+            out.vis = 0.f;
+            out.alpha = 0.f;
+            out.valid = false;
+            out.pre_drop = true;
+            return out;
+        }
+        const float sigma_clamp = logf(opac / MAX_ALPHA);
+        if(opac >= MAX_ALPHA && sigma <= sigma_clamp)
+        {
+            // vis is retained as the exact clamp boundary ratio for the
+            // downstream saturated-alpha branch; alpha itself needs no exp.
+            out.vis = MAX_ALPHA / opac;
+            out.alpha = MAX_ALPHA;
+            out.valid = true;
+            out.pre_clamp = true;
+            return out;
+        }
+    }
+    out.vis = __expf(-sigma);
+    out.alpha = min(MAX_ALPHA, opac * out.vis);
+    out.valid = !(sigma < 0.f || out.alpha < ALPHA_THRESHOLD);
+    return out;
+}
+
+template<uint32_t CDIM, bool SCALAR_ADJOINT, bool UV_REUSE>
+__device__ __forceinline__ void higs_cf_blend_bwd_step(
+    const vec3 &conic,
+    const vec2 &delta,
+    const float opac,
+    const HigsCfWeight &gw,
+    const float *__restrict__ rgbs,
+    const float *__restrict__ v_render_c,
+    const float v_render_a,
+    const float T_final,
+    const float *__restrict__ backgrounds,
+    float &T,
+    float (&buffer)[CDIM],
+    float &buffer_dot,
+    const float tail_const,
+    float (&v_rgb_local)[CDIM],
+    vec3 &v_conic_local,
+    vec2 &v_xy_local,
+    float &v_opacity_local)
+{
+    const float ra = 1.0f / fmaxf(MIN_ONE_MINUS_ALPHA, 1.0f - gw.alpha);
+    T *= ra;
+    const float fac = gw.alpha * T;
+    float rgb_dot = 0.f;
+#pragma unroll
+    for(uint32_t k = 0; k < CDIM; ++k)
+    {
+        v_rgb_local[k] = fac * v_render_c[k];
+        if constexpr(SCALAR_ADJOINT)
+        {
+            rgb_dot += rgbs[k] * v_render_c[k];
+        }
+    }
+    float v_alpha = 0.f;
+    if constexpr(SCALAR_ADJOINT)
+    {
+        v_alpha = T * rgb_dot + ra * (tail_const - buffer_dot);
+    }
+    else
+    {
+#pragma unroll
+        for(uint32_t k = 0; k < CDIM; ++k)
+        {
+            v_alpha += (rgbs[k] * T - buffer[k] * ra) * v_render_c[k];
+        }
+        v_alpha += T_final * ra * v_render_a;
+        if(backgrounds != nullptr)
+        {
+            float bg_dot = 0.f;
+#pragma unroll
+            for(uint32_t k = 0; k < CDIM; ++k)
+            {
+                bg_dot += backgrounds[k] * v_render_c[k];
+            }
+            v_alpha -= T_final * ra * bg_dot;
+        }
+    }
+    // The pre-clamp region is saturated by construction.  The non-gated path
+    // preserves the baseline's <= subgradient predicate unchanged.
+    if(!gw.pre_clamp && opac * gw.vis <= MAX_ALPHA)
+    {
+        const float v_sigma = -opac * gw.vis * v_alpha;
+        v_conic_local = {0.5f * v_sigma * delta.x * delta.x,
+                         v_sigma * delta.x * delta.y,
+                         0.5f * v_sigma * delta.y * delta.y};
+        if constexpr(UV_REUSE)
+        {
+            v_xy_local = {v_sigma * gw.ux, v_sigma * gw.uy};
+        }
+        else
+        {
+            v_xy_local = {v_sigma * (conic.x * delta.x + conic.y * delta.y),
+                          v_sigma * (conic.y * delta.x + conic.z * delta.y)};
+        }
+        v_opacity_local = gw.vis * v_alpha;
+    }
+    if constexpr(SCALAR_ADJOINT)
+    {
+        buffer_dot += rgb_dot * fac;
+    }
+    else
+    {
+#pragma unroll
+        for(uint32_t k = 0; k < CDIM; ++k)
+        {
+            buffer[k] += rgbs[k] * fac;
+        }
+    }
+}
