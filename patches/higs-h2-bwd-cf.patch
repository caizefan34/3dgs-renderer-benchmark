+    constexpr bool SCALAR_ADJOINT = (VARIANT & HIGS_BWD_CF_SCALAR_ADJOINT) != 0;
+    constexpr bool UV_REUSE = (VARIANT & HIGS_BWD_CF_UV_REUSE) != 0;
