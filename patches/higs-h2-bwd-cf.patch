+#pragma unroll
+            for(uint32_t k = 0; k < CDIM; ++k) rgbs_batch[tr * CDIM + k] = colors[(int64_t)g * CDIM + k];
+        }
+        block.sync();
+        for(uint32_t t = (uint32_t)max(0, batch_end - warp_bin_final); t < (uint32_t)batch_size; ++t)
+        {
+            float v_rgb_local[CDIM] = {0.f}; vec3 v_conic_local = {0.f, 0.f, 0.f};
+            vec2 v_xy_local = {0.f, 0.f}; float v_opacity_local = 0.f; bool any_valid = false;
+#pragma unroll
+            for(uint32_t q = 0; q < PX; ++q)
+            {
+                valid[q] = inside[q] && (batch_end - (int32_t)t <= bin_final[q]);
+                if(valid[q])
