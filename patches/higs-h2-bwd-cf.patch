+template<uint32_t CDIM, uint32_t PX, int VARIANT>
+__global__ void __launch_bounds__(256 / PX, PX == 1 ? 5 : PX == 2 ? 5 : PX == 4 ? 8 : 10)
+higs_blend_bwd_px_cf_kernel(
+    const uint32_t I, const uint32_t N, const uint32_t n_isects,
+    const vec2 *__restrict__ means2d, const vec3 *__restrict__ conics,
+    const float *__restrict__ colors, const float *__restrict__ opacities,
+    const float *__restrict__ backgrounds, const uint32_t tile_width,
+    const uint32_t tile_height, const int32_t *__restrict__ active_tiles,
+    const bool skip_background_atomic, const uint32_t image_width,
+    const uint32_t image_height, const uint32_t tile_size,
+    const int32_t *__restrict__ tile_offsets, const int32_t *__restrict__ flatten_ids,
+    const float *__restrict__ render_alphas, const int32_t *__restrict__ last_ids,
+    const float *__restrict__ v_render_colors, const float *__restrict__ v_render_alphas,
+    vec2 *__restrict__ v_means2d, vec3 *__restrict__ v_conics,
+    float *__restrict__ v_colors, float *__restrict__ v_opacities,
+    float *__restrict__ v_backgrounds, uint64_t *__restrict__ sigma_stats)
+{
