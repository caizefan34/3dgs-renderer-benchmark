+import torch
+from torch import Tensor
+from typing import Any, Optional, Callable
+
+
+
+def _higs_frozen_forward(means, quats, scales, opacities, colors, viewmats, Ks, width, height, sh_degree, bg, tile_size, near_plane, far_plane, radius_clip, eps2d, camera_model, render_mode):
+    '''Forward pass for frozen-topology differentiable rendering.
+    
+    Calls the standard gsplat rasterization which already has full autograd support.
+    In Stage C, this would use HiGS-native culling + scatter-add backward.
+    '''
+    from gsplat.rendering import rasterization
+    means_b = means.unsqueeze(0)
+    quats_b = quats.unsqueeze(0)
+    scales_b = scales.unsqueeze(0)
+    opacities_b = opacities.unsqueeze(0)
+    colors_b = colors.unsqueeze(0) if colors.dim() == 2 else colors
+    backgrounds = bg.unsqueeze(0).unsqueeze(0) if bg is not None else None
+    render_colors, render_alphas, meta = rasterization(
+        means=means_b, quats=quats_b, scales=scales_b,
+        opacities=opacities_b, colors=colors_b,
+        viewmats=viewmats, Ks=Ks,
+        width=width, height=height,
+        sh_degree=sh_degree, backgrounds=backgrounds,
+        packed=True, tile_size=tile_size,
+        near_plane=near_plane, far_plane=far_plane,
+        radius_clip=radius_clip, eps2d=eps2d,
+        camera_model=camera_model, render_mode=render_mode,
+    )
+    frame = render_colors.squeeze(0).squeeze(0)
+    alpha = render_alphas.squeeze(0).squeeze(0)
+    return frame[None], alpha[None]
+
+def rasterize_gaussian_higs_frozen(
+    means: Tensor,
+    quats: Tensor,
+    scales: Tensor,
+    opacities: Tensor,
+    colors: Tensor,
+    *,
+    sh_degree: Optional[int] = None,
+    viewmats: Tensor,
+    Ks: Tensor,
+    width: int,
+    height: int,
+    tile_size: int = 16,
+    near_plane: float = 0.01,
+    far_plane: float = 1e10,
+    radius_clip: float = 0.0,
+    eps2d: float = 0.3,
+    background: Optional[Tensor] = None,
+    render_mode: str = "RGB",
+    camera_model: str = "pinhole",
+    cached_higs_renderer: Optional[Any] = None,
+) -> dict:
+    """Differentiable HiGS rendering with frozen-topology support (Stage B)."""
+    frame, alpha = _higs_frozen_forward(
+        means, quats, scales, opacities, colors,
+        viewmats, Ks, width, height, sh_degree,
+        background, tile_size, near_plane, far_plane,
+        radius_clip, eps2d, camera_model, render_mode,
+    )
+    return {"frame": frame, "alpha": alpha, "metadata": {}}
+
+__all__ = [
+    "rasterize_gaussian_inference_scene",
+    "rasterize_gaussian_higs_trainable",
+    "rasterize_gaussian_higs_frozen",
+]
