+            means=means.unsqueeze(0).contiguous(),
+            covars=None,
+            quats=quats.unsqueeze(0).contiguous(),
+            scales=scales.unsqueeze(0).contiguous(),
+            viewmats=viewmats.contiguous(),
+            Ks=Ks.contiguous(),
+            width=width, height=height, eps2d=eps2d,
+            packed=False,
