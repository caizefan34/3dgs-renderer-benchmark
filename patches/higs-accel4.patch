+# accel4 sparse / error-guided tile training helpers. Tile masks follow the
+# renderer layout [B, tile_height, tile_width]; frames are channel-last
+# [B, H, W, 3]. The sampled-tile mean is an unbiased estimator of the
+# full-frame mean; the error-guided variant additionally importance-weights
+# tiles so the estimator stays unbiased for any p > 0.
+_HIGS_TILE_SIZE = 16  # must match the renderer tile_size
+
+def _higs_tile_mean_errors(frame, ref, tile_size):
+    """Exact per-tile mean |diff| over RGB (border tiles by real pixels)."""
+    diff = (frame - ref).abs()  # [B, H, W, 3]
+    B, H, W, _ = diff.shape
+    th = (H + tile_size - 1) // tile_size
+    tw = (W + tile_size - 1) // tile_size
+    Hp, Wp = th * tile_size, tw * tile_size
+    diff_pad = torch.nn.functional.pad(diff, (0, 0, 0, Wp - W, 0, Hp - H))
+    tile_sum = diff_pad.reshape(B, th, tile_size, tw, tile_size, 3).sum(
+        dim=(2, 4, 5)
+    )  # [B, th, tw]
+    rows = torch.full((th,), tile_size, dtype=torch.long, device=diff.device)
+    cols = torch.full((tw,), tile_size, dtype=torch.long, device=diff.device)
+    rows[-1] = H - (th - 1) * tile_size
+    cols[-1] = W - (tw - 1) * tile_size
+    count = (rows[:, None] * cols[None, :] * 3).to(diff.dtype)
+    return tile_sum / count  # [B, th, tw]
+
+def _higs_error_guided_mask(tile_err, ratio, alpha, device, lambda_mix=1.0):
+    """Importance-sample k tiles per image with p proportional to err^alpha.
+
+    Returns (mask [B, th*tw] bool, weights [B, th*tw] float32) with weights =
+    m / (k * p) so the weighted sampled estimate is unbiased for any p > 0.
+    """
+    B, th, tw = tile_err.shape
+    n = th * tw
+    k = max(1, int(round(n * ratio)))
+    e = tile_err.reshape(B, n)
+    floor = (1e-3 * e.mean(dim=1, keepdim=True)).clamp_min(1e-6)
+    p = (e + floor) ** alpha
+    p = p / p.sum(dim=1, keepdim=True)
+    if 0.0 <= lambda_mix < 1.0:
+        p = (1.0 - lambda_mix) / n + lambda_mix * p
+    idx = torch.multinomial(p, k, replacement=True)  # [B, k]
+    m = torch.zeros(B, n, dtype=torch.float32, device=e.device)
+    m.scatter_add_(1, idx, torch.ones_like(idx, dtype=torch.float32))
+    mask = m > 0
+    weights = m / (k * p)
+    return mask, weights
+
+def _higs_masked_tile_l1(frame, ref, tile_mask, tile_size, width, height):
+    """Unbiased sampled-tile L1: mean |diff| over sampled-tile pixels."""
+    diff = (frame - ref).abs()  # [B, H, W, 3]
+    pm = (
+        tile_mask.repeat_interleave(tile_size, dim=1)
+        .repeat_interleave(tile_size, dim=2)[:, :height, :width]
+        .unsqueeze(-1)
+    )
+    return diff.masked_select(pm.expand_as(diff)).mean()
+
+def _higs_importance_tile_l1(frame, ref, mask, weights, tile_size, width, height):
+    """Unbiased tile-level importance estimate of the full-frame L1."""
+    diff = (frame - ref).abs()  # [B, H, W, 3]
+    B, H, W, _ = diff.shape
+    th = (H + tile_size - 1) // tile_size
+    tw = (W + tile_size - 1) // tile_size
+    Hp, Wp = th * tile_size, tw * tile_size
+    diff_pad = torch.nn.functional.pad(diff, (0, 0, 0, Wp - W, 0, Hp - H))
+    tile_sum = diff_pad.reshape(B, th, tile_size, tw, tile_size, 3).sum(
+        dim=(2, 4, 5)
+    )
+    p_total = B * width * height * 3
+    m = mask.reshape(B, th, tw).to(diff.dtype)
+    w = weights.reshape(B, th, tw)
+    return (m * w * tile_sum).sum() / p_total
