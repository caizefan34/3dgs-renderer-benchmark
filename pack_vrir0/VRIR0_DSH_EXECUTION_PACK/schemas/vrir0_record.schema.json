{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VRIR0 oracle observation",
  "type": "object",
  "required": [
    "scene",
    "iteration",
    "camera_id",
    "cache_age_iters",
    "topology_epoch",
    "eligible",
    "certificate",
    "truth_same",
    "false_accept",
    "n_isects",
    "cache_bytes"
  ],
  "properties": {
    "scene": {
      "type": "string"
    },
    "iteration": {
      "type": "integer"
    },
    "camera_id": {
      "type": "integer"
    },
    "cache_age_iters": {
      "type": "integer",
      "minimum": 1
    },
    "topology_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "eligible": {
      "type": "boolean"
    },
    "reject_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "certificate": {
      "type": "object",
      "required": [
        "config",
        "topology",
        "numeric",
        "membership",
        "order_exact_scan",
        "order_slack_n",
        "accept"
      ],
      "properties": {
        "config": {
          "type": "boolean"
        },
        "topology": {
          "type": "boolean"
        },
        "numeric": {
          "type": "boolean"
        },
        "membership": {
          "type": "boolean"
        },
        "accept": {
          "type": "boolean"
        },
        "order_exact_scan": {
          "type": "boolean"
        },
        "order_slack_n": {
          "type": "boolean"
        }
      }
    },
    "truth_same": {
      "type": "boolean"
    },
    "false_accept": {
      "type": "boolean"
    },
    "false_reject": {
      "type": "boolean"
    },
    "tile_truth_same_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "adjacent_order_violations": {
      "type": "integer",
      "minimum": 0
    },
    "adjacent_pairs_checked": {
      "type": "integer",
      "minimum": 0
    },
    "n_isects": {
      "type": "integer",
      "minimum": 0
    },
    "cache_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "drift": {
      "type": "object"
    }
  }
}