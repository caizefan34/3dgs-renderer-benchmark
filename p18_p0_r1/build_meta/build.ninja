ninja_required_version = 1.3
cxx = c++
nvcc = /root/miniforge3/envs/gsplat/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=experimental_gaussian_render_inference_scene_cuda -DTORCH_API_INCLUDE_EXTENSION_H -I/root/epic05_frozen/higs_c0_final30k_worktree/gsplat/cuda/include -I/root/epic05_frozen/higs_c0_final30k_worktree/gsplat/cuda/csrc -I/root/epic05_frozen/higs_c0_final30k_worktree/gsplat/experimental/render/kernels/cuda/csrc/gaussian_inference -I/root/epic05_frozen/higs_c0_final30k_worktree/gsplat/cuda/csrc/third_party/glm -I/root/miniforge3/envs/gsplat/targets/x86_64-linux/include -isystem /root/miniforge3/envs/gsplat/lib/python3.10/site-packages/torch/include -isystem /root/miniforge3/envs/gsplat/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /root/miniforge3/envs/gsplat/include -isystem /root/miniforge3/envs/gsplat/include/python3.10 -fPIC -std=c++17 -std=c++20 -O3 -DNDEBUG -Wno-attributes -Wno-unknown-pragmas -DAT_PARALLEL_OPENMP -fopenmp
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=experimental_gaussian_render_inference_scene_cuda -DTORCH_API_INCLUDE_EXTENSION_H -I/root/epic05_frozen/higs_c0_final30k_worktree/gsplat/cuda/include -I/root/epic05_frozen/higs_c0_final30k_worktree/gsplat/cuda/csrc -I/root/epic05_frozen/higs_c0_final30k_worktree/gsplat/experimental/render/kernels/cuda/csrc/gaussian_inference -I/root/epic05_frozen/higs_c0_final30k_worktree/gsplat/cuda/csrc/third_party/glm -I/root/miniforge3/envs/gsplat/targets/x86_64-linux/include -isystem /root/miniforge3/envs/gsplat/lib/python3.10/site-packages/torch/include -isystem /root/miniforge3/envs/gsplat/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -isystem /root/miniforge3/envs/gsplat/include -isystem /root/miniforge3/envs/gsplat/include/python3.10 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_80,code=sm_80 --compiler-options '-fPIC' --forward-unknown-opts -use_fast_math -diag-suppress 20012,186 --expt-relaxed-constexpr -std=c++20 -O3 -DNDEBUG -Wno-attributes -Wno-unknown-pragmas -DAT_PARALLEL_OPENMP -fopenmp
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -s -L/root/miniforge3/envs/gsplat/lib/python3.10/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/root/miniforge3/envs/gsplat/lib -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build ext.o: compile /root/epic05_frozen/higs_c0_final30k_worktree/gsplat/experimental/render/kernels/cuda/ext.cpp
build GaussianRenderInferenceScene.cuda.o: cuda_compile /root/epic05_frozen/higs_c0_final30k_worktree/gsplat/experimental/render/kernels/cuda/csrc/gaussian_inference/GaussianRenderInferenceScene.cu
build GatherVisible.cuda.o: cuda_compile /root/epic05_frozen/higs_c0_final30k_worktree/gsplat/experimental/render/kernels/cuda/csrc/gaussian_inference/GatherVisible.cu
build GatherlessProjectedProducer.cuda.o: cuda_compile /root/epic05_frozen/higs_c0_final30k_worktree/gsplat/experimental/render/kernels/cuda/csrc/gaussian_inference/GatherlessProjectedProducer.cu
build HigsNativeBackward.cuda.o: cuda_compile /root/epic05_frozen/higs_c0_final30k_worktree/gsplat/experimental/render/kernels/cuda/csrc/gaussian_inference/HigsNativeBackward.cu
build IntersectCommon.cuda.o: cuda_compile /root/epic05_frozen/higs_c0_final30k_worktree/gsplat/experimental/render/kernels/cuda/csrc/gaussian_inference/IntersectCommon.cu
build IntersectMTFused.cuda.o: cuda_compile /root/epic05_frozen/higs_c0_final30k_worktree/gsplat/experimental/render/kernels/cuda/csrc/gaussian_inference/IntersectMTFused.cu
build MacroTileIntersect.cuda.o: cuda_compile /root/epic05_frozen/higs_c0_final30k_worktree/gsplat/experimental/render/kernels/cuda/csrc/gaussian_inference/MacroTileIntersect.cu
build MacroTileRasterize.cuda.o: cuda_compile /root/epic05_frozen/higs_c0_final30k_worktree/gsplat/experimental/render/kernels/cuda/csrc/gaussian_inference/MacroTileRasterize.cu
build Projection.cuda.o: cuda_compile /root/epic05_frozen/higs_c0_final30k_worktree/gsplat/experimental/render/kernels/cuda/csrc/gaussian_inference/Projection.cu
build SegmentedSort.cuda.o: cuda_compile /root/epic05_frozen/higs_c0_final30k_worktree/gsplat/experimental/render/kernels/cuda/csrc/gaussian_inference/SegmentedSort.cu
build SHCompression.cuda.o: cuda_compile /root/epic05_frozen/higs_c0_final30k_worktree/gsplat/experimental/render/kernels/cuda/csrc/gaussian_inference/SHCompression.cu
build SphericalHarmonics.cuda.o: cuda_compile /root/epic05_frozen/higs_c0_final30k_worktree/gsplat/experimental/render/kernels/cuda/csrc/gaussian_inference/SphericalHarmonics.cu





build experimental_gaussian_render_inference_scene_cuda.so: link ext.o GaussianRenderInferenceScene.cuda.o GatherVisible.cuda.o GatherlessProjectedProducer.cuda.o HigsNativeBackward.cuda.o IntersectCommon.cuda.o IntersectMTFused.cuda.o MacroTileIntersect.cuda.o MacroTileRasterize.cuda.o Projection.cuda.o SegmentedSort.cuda.o SHCompression.cuda.o SphericalHarmonics.cuda.o

default experimental_gaussian_render_inference_scene_cuda.so
